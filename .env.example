# Kopiere diese Datei nach .env und trage deinen Schlüssel ein (lokal).
# Online (Netlify): dieselben Namen unter Site settings → Environment variables eintragen.

# Pflicht für Abenteuer mit Claude als Spielleiter
ANTHROPIC_API_KEY=

# Online Pflicht: langes Zufallsgeheimnis zum Signieren der Spielstände (lokal wird es automatisch erzeugt)
GAME_SECRET=

# Online dringend empfohlen: Zugangscode, den Spieler einmal eingeben müssen
ACCESS_CODE=

# Optional: harte Kostengrenze pro Monat in US-Dollar (leer = keine Grenze)
MONTHLY_BUDGET_USD=

# Züge pro Stunde und Besucher (Standard 60)
TURNS_PER_HOUR=60

# Denktiefe des Spielleiters: low (schnell, günstig), medium, high
GM_EFFORT=low

# Modell des Spielleiters (Standard: claude-opus-5-5 – beste Qualität)
# GM_MODEL=claude-opus-5-5
# REVIEW_MODEL=claude-opus-5-5

# Optional: Bilder über fal.ai (Szenenbilder und Figurenporträts, Modell FLUX.2 [dev], ca. 1,2 Cent pro Bild).
# Ohne Schlüssel gibt es einfach keine Bilder. Bildkosten zählen zum Monatsbudget und zu den Kampagnenkosten.
FAL_KEY=
